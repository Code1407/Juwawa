{
  "compilerOptions": {
    "target": "ES2020", // 编译目标 JS 版本
    "module": "CommonJS", // 【关键】使用 CommonJS 模块规范
    "types": [
      "node"
    ],
    "outDir": "./dist", // 编译后文件输出目录
    "rootDir": "./src", // 源码目录
    "strict": true, // 开启严格类型检查
    "esModuleInterop": true, // 兼容 CommonJS/ES 模块导入
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ], // 包含 src 下所有文件
  "exclude": [
    "node_modules"
  ] // 排除依赖
}