  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "node": {
      "__id__": 2313
    },
    "_enabled": true,
    "_fontFamily": "Arial",
    "_isSystemFontUsed": true,
    "_N$string": "  1.\"The Combo Multiplier\" has 5 levels as x1, x2, x3, x5 in Main Game.\n  2.Points won each matching will be multiplied based on the current \"Combo Multiplier\"\n  3.The Multiplier is increased to x1 for \"The First Matching\" of each spin.\n  4.The Multiplier is increased to x2 for \"The Second Matching\" of each spin.\n  5.The Multiplier is increased to x3 for \"The Third Matching\" of each spin.\n  6.The Multiplier is increased to x5 for \"The Fourth Matching\" of each spin.\n  7.The Multiplier is increased to the final level x10 for \"The Fiveth or more Matching\" of each spin.\n  8.If the symbols do not match, the \"Combo Multiplier\" resets to x1.\n  9.If there is a win at a main game (after the winning symbols disappearing and the new symbols falling down for the replacement),\nall the symbols on screen are potential to win with combo multiplier for the second, third, fourth, fifth ,sixth or more matching,\nand so on if any winning way is awarded.",
    "_N$horizontalAlign": 0,
    "_N$fontSize": 27,
    "_N$font": null,
    "_N$cacheMode": 0,
    "_N$maxWidth": 830,
    "_N$lineHeight": 50,
    "_N$imageAtlas": null,
    "_N$handleTouchEvent": true,
    "_id": "e9J9Rd48ZJCKb7/B+fu8UZ"
  },
