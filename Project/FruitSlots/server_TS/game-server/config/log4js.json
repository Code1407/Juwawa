{
  "appenders": {
    "sdk": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/game_logs/sdk_${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "mysql": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/game_logs/mysql.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "redis": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/game_logs/redis.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "FerrisWheel": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/game_logs/FerrisWheel_${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "FruitSlots": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/game_logs/FruitSlots_${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "console": {
      "type": "console"
    },
    "con-log": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/con-log-${opts:serverId}.log",
      "pattern": "connector",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "rpc-log": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/rpc-log-${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "forward-log": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/forward-log-${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "rpc-debug": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/rpc-debug-${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "crash-log": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/crash.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "admin-log": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/admin.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "pinus": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/pinus-${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "pinus-admin": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/pinus-admin.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    },
    "pinus-rpc": {
      "type": "file",
      "filename": "${opts:base}/../../../../logs/pinus/pinus-rpc-${opts:serverId}.log",
      "maxLogSize": 1048576,
      "layout": {
        "type": "basic"
      },
      "backups": 5
    }
  },
  "categories": {
    "sdk": {
      "appenders": [
        "sdk"
      ],
      "level": "warn"
    },
    "mysql": {
      "appenders": [
        "mysql"
      ],
      "level": "warn"
    },
    "redis": {
      "appenders": [
        "redis"
      ],
      "level": "warn"
    },
    "FerrisWheel": {
      "appenders": [
        "FerrisWheel"
      ],
      "level": "warn"
    },
    "FruitSlots": {
      "appenders": [
        "FruitSlots"
      ],
      "level": "warn"
    },
    "default": {
      "appenders": [
        "console",
        "pinus"
      ],
      "level": "info"
    },
    "con-log": {
      "appenders": [
        "con-log"
      ],
      "level": "warn"
    },
    "rpc-log": {
      "appenders": [
        "rpc-log"
      ],
      "level": "warn"
    },
    "forward-log": {
      "appenders": [
        "forward-log"
      ],
      "level": "warn"
    },
    "rpc-debug": {
      "appenders": [
        "rpc-debug"
      ],
      "level": "warn"
    },
    "crash-log": {
      "appenders": [
        "crash-log"
      ],
      "level": "warn"
    },
    "admin-log": {
      "appenders": [
        "admin-log"
      ],
      "level": "warn"
    },
    "pinus-admin": {
      "appenders": [
        "pinus-admin"
      ],
      "level": "warn"
    },
    "pinus-rpc": {
      "appenders": [
        "pinus-rpc"
      ],
      "level": "warn"
    }
  },
  "prefix": "${opts:serverId} ",
  "replaceConsole": true,
  "lineDebug": false,
  "errorStack": true
}